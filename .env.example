# Copia este archivo a .env y llena SOLO el proveedor que usemos. .env no se sube a git.
LLM_PROVIDER=openai          # openai | azure | anthropic | ollama
LLM_MODEL=gpt-4o             # modelo con visión (los PDFs son escaneos)

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434
