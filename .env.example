# Copiar a .env (ignorado por git) y llenar. Nunca subir el .env.

# LLM. Decisión 1: Haiku por costo (ver "Uso de la API" en el README). No subir a Sonnet/Opus sin avisar.
LLM_PROVIDER=anthropic          # anthropic | openai | google
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Langfuse. PENDIENTE Juan Pablo: cloud de la organización o local con Docker (regla 06)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Rutas (opcional)
# DOCUMENTOS_DIR=Documentos
# CACHE_DIR=cache
